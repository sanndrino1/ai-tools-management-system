# Optimized Dockerfile for Laravel Application
# Using pre-built PHP image with extensions to avoid compilation

# =============================================================================
# Base PHP image with pre-compiled extensions
# =============================================================================
FROM serversideup/php:8.2-fpm-nginx AS base

# Install additional system dependencies
USER root
RUN apt-get update && apt-get install -y \
    supervisor \
    redis-tools \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /var/www/html

# =============================================================================
# Development Stage
# =============================================================================
FROM base AS development

# Copy application code
COPY --chown=www-data:www-data . .

# Install Composer dependencies
USER www-data
RUN composer install --optimize-autoloader

# Copy configuration files
USER root
COPY docker/supervisor/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/nginx/default.conf /etc/nginx/sites-available/default

# Set permissions
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 storage bootstrap/cache

# Expose ports
EXPOSE 80 9000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost/api/health || exit 1

# Start supervisor
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]

# =============================================================================
# Production Stage  
# =============================================================================
FROM base AS production

# Copy application code
COPY --chown=www-data:www-data . .

# Install production dependencies
USER www-data
RUN composer install --no-dev --optimize-autoloader --no-scripts \
    && composer dump-autoload --optimize

# Laravel optimizations
RUN php artisan config:cache \
    && php artisan route:cache \
    && php artisan view:cache

USER root

# Remove development files
RUN rm -rf tests docker .git \
    && rm -f docker-compose* README.md

# Copy production configuration
COPY docker/supervisor/supervisord.prod.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/nginx/nginx.prod.conf /etc/nginx/sites-available/default

# Set final permissions
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 storage bootstrap/cache \
    && chmod -R 644 /var/www/html

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost/api/health || exit 1

# Start supervisor
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]