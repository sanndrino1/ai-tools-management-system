# AI Tools Management System - Environment Configuration

# =============================================================================
# Laravel Backend Environment
# =============================================================================

# Application
APP_NAME="AI Tools Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ai_tools
DB_USERNAME=laravel
DB_PASSWORD=laravel_password

# Broadcasting
BROADCAST_DRIVER=log
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@aitools.dev"
MAIL_FROM_NAME="${APP_NAME}"

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# Laravel Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# API Rate Limiting
API_RATE_LIMIT=60

# JWT Secret (if using JWT)
JWT_SECRET=

# File Upload Limits
MAX_UPLOAD_SIZE=51200
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx

# AI Tools System Specific
SYSTEM_TIMEZONE=Europe/Sofia
DEFAULT_USER_ROLE=user
ADMIN_EMAIL=admin@aitools.dev

# Docker Development
WWWUSER=1000
WWWGROUP=1000

# =============================================================================
# Production Overrides (uncomment for production)
# =============================================================================

# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-domain.com

# DB_HOST=your-production-db-host
# DB_DATABASE=your-production-db
# DB_USERNAME=your-production-user
# DB_PASSWORD=your-secure-password

# REDIS_HOST=your-production-redis-host
# REDIS_PASSWORD=your-redis-password

# MAIL_MAILER=smtp
# MAIL_HOST=your-smtp-host
# MAIL_PORT=587
# MAIL_USERNAME=your-email@domain.com
# MAIL_PASSWORD=your-email-password
# MAIL_ENCRYPTION=tls