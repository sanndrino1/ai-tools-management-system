# Next.js Environment Variables for AI Tools Management System

# =============================================================================
# Application Configuration
# =============================================================================

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost/api

# Environment
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# =============================================================================
# API Configuration  
# =============================================================================

# Laravel Backend (Internal Docker Network)
NEXT_PRIVATE_API_URL=http://laravel-app:9000/api

# External API Endpoints
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:6001

# =============================================================================
# Authentication
# =============================================================================

# JWT Settings
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# OAuth Providers (if using social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# Feature Flags
# =============================================================================

# Enable/disable features
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_CHAT=false
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true

# =============================================================================
# Third-party Services
# =============================================================================

# Analytics
NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_HOTJAR_ID=

# Error Tracking
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# File Upload
NEXT_PUBLIC_MAX_FILE_SIZE=50485760
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# =============================================================================
# Performance & Caching
# =============================================================================

# Cache settings
NEXT_PUBLIC_CACHE_DURATION=300
NEXT_PUBLIC_REVALIDATE_TIME=60

# Image optimization
NEXT_PUBLIC_IMAGE_DOMAINS=localhost,127.0.0.1,your-domain.com

# =============================================================================
# Development Settings
# =============================================================================

# Debug mode
NEXT_PUBLIC_DEBUG=true

# Hot reload settings
WATCHPACK_POLLING=true
CHOKIDAR_USEPOLLING=true

# =============================================================================
# Production Overrides (uncomment for production)
# =============================================================================

# NODE_ENV=production
# NEXT_PUBLIC_APP_URL=https://your-domain.com
# NEXT_PUBLIC_API_URL=https://your-api-domain.com/api
# NEXT_PUBLIC_DEBUG=false
# NEXT_PUBLIC_ENABLE_ANALYTICS=true